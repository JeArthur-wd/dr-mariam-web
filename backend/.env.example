# Keep real credentials out of source control. Copy this file to backend/.env.
# A publicly reachable HTTPS callback is required for production payment confirmation.
PAYMENT_CALLBACK_SECRET=replace-with-a-long-random-value
MTN_MOBILE_MONEY_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOBILE_MONEY_CLIENT_ID=
MTN_MOBILE_MONEY_CLIENT_SECRET=
MTN_MOBILE_MONEY_SUBSCRIPTION_KEY=
MTN_MOBILE_MONEY_TARGET_ENV=sandbox
# Include ?token=<PAYMENT_CALLBACK_SECRET> in the configured callback URL.
MTN_MOBILE_MONEY_CALLBACK_URL=https://your-domain.example/api/payments/callback/?token=replace-with-a-long-random-value
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_CALLBACK_URL=https://your-domain.example/api/payments/callback/?token=replace-with-a-long-random-value
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Dr Mariam Nagujja Ladies Guide <tickets@your-domain.example>
